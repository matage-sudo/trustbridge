    "helmet": "8.0.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "sharp": "^0.35.5",
    "uuid": "11.0.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "22.9.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "dotenv-safe": "^9.1.0",
    "jest": "^29.7.0",
    "pg": "^8.23.1",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
