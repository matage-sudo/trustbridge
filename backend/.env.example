PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
LOG_LEVEL=info

# JWT: only allow header-based dev fallback when this is 'true'.
# Must be 'false' or unset in production.
ALLOW_DEV_HEADERS=false

# For diagnostic scripts that need to log in as a real user.
SUPABASE_ANON_KEY=
