generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model User {
  id String @id @db.Uuid
  @@schema("auth")
  @@ignore
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  @@schema("public")
}

enum MembershipRole {
  PATIENT
  STAFF
  HOSPITAL_ADMIN
  PRIVACY_OFFICER
  SECURITY_INVESTIGATOR
  SUPER_ADMIN
  @@schema("public")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  @@schema("public")
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("public")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  @@schema("public")
}

enum AccessPurpose {
  TREATMENT
  DIAGNOSIS
  LAB_REVIEW
  PHARMACY_DISPENSE
  BILLING
  RESEARCH
  TEACHING
  AUDIT_REVIEW
  @@schema("public")
}

model Tenant {
  representatives Representative[]
  documents PatientDocument[]
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships    Membership[]
  patients       Patient[]
  departments    Department[]
  appointments   Appointment[]
  consents       Consent[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  dsrRequests DataSubjectRequest[]
  patientSessions PatientSession[]
  patientDevices  PatientDevice[]
  securityAlerts  SecurityAlert[]
  auditEvents     AuditEvent[]

  @@map("tenants")
  @@schema("public")
}

model UserIdentity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("user_identities")
  @@schema("public")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
  @@schema("public")
}

model Membership {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @db.Uuid
  userId           String         @db.Uuid
  role             MembershipRole
  active           Boolean        @default(true)
  departmentId     String?        @db.Uuid
  patientId        String?        @db.Uuid
  employmentStatus String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  patient        Patient?       @relation("MembershipPatient", fields: [patientId], references: [id], onDelete: SetNull)

  appointments              Appointment[]
  accessRequestsAsRequester AccessRequest[] @relation("AccessRequestsAsRequester")
  accessGrantsAsGrantee     AccessGrant[]   @relation("AccessGrantsAsGrantee")
  dsrRequestsAsRequester DataSubjectRequest[] @relation("DsrRequester")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([patientId])
  @@map("memberships")
  @@schema("public")
}

model Patient {
  notifications Notification[]
  representatives Representative[]
  documents PatientDocument[]
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime @db.Date
  hospitalNumber String   @unique
  phone                 String?
  email                 String?
  gender                String?
  nationalId            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  profilePhotoUrl       String?
  verifiedAt            DateTime?
  lastProfileUpdateAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  consents       Consent[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  membershipsAsPatient Membership[] @relation("MembershipPatient")

  @@index([tenantId])
  @@map("patients")
  @@schema("public")
}

model Appointment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @db.Uuid
  patientId    String            @db.Uuid
  staffId      String            @db.Uuid
  scheduledAt  DateTime
  durationMins Int               @default(30)
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staff   Membership @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@index([patientId])
  @@index([staffId])
  @@map("tb_appointments")
  @@schema("public")
}

model Consent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @db.Uuid
  patientId        String        @db.Uuid
  purpose          String
  noticeVersion    String
  language         String        @default("en")
  grantedAt        DateTime      @default(now())
  effectiveFrom    DateTime      @default(now())
  expiresAt        DateTime?
  status           ConsentStatus @default(ACTIVE)
  revokedAt        DateTime?
  revocationReason String?
  capturedBy       String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([patientId])
  @@map("tb_consents")
  @@schema("public")
}

model AccessRequest {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @db.Uuid
  requesterId            String              @db.Uuid
  patientId              String              @db.Uuid
  purpose                AccessPurpose
  reason                 String
  requestedDurationHours Int                 @default(4)
  status                 AccessRequestStatus @default(PENDING)
  decisionReason         String?
  decidedBy              String?             @db.Uuid
  decidedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester Membership @relation("AccessRequestsAsRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grant     AccessGrant?

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([patientId])
  @@map("tb_access_requests")
  @@schema("public")
}

model AccessGrant {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @db.Uuid
  requestId        String        @unique @db.Uuid
  granteeId        String        @db.Uuid
  patientId        String        @db.Uuid
  purpose          AccessPurpose
  grantedAt        DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantee Membership    @relation("AccessGrantsAsGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([granteeId])
  @@index([patientId])
  @@index([expiresAt])
  @@map("tb_access_grants")
  @@schema("public")
}

model AuditEvent {
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  resourceType  String?
  resourceId    String?
  outcome       String
  reasonCode    String?
  correlationId String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
  @@schema("public")
}
enum DsrType {
  ACCESS
  CORRECTION
  ERASURE
  OBJECTION
  PORTABILITY
  COMPLAINT
  @@schema("public")
}

enum DsrStatus {
  SUBMITTED
  UNDER_REVIEW
  RESPONDED
  CLOSED
  @@schema("public")
}

model DataSubjectRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  referenceNumber String   @unique
  requesterId    String    @db.Uuid   // Membership.id
  patientId      String?   @db.Uuid   // the patient this request concerns (usually same as requester's linked patient)
  type           DsrType
  status         DsrStatus @default(SUBMITTED)
  description    String
  adminResponse  String?
  respondedBy    String?   @db.Uuid   // Membership.id
  respondedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester Membership @relation("DsrRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([referenceNumber])
  @@map("tb_data_subject_requests")
  @@schema("public")
}
// ============================================================
// Security Centre (Sessions, Devices, Alerts)
// ============================================================

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("public")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  @@schema("public")
}

enum AlertKind {
  NEW_DEVICE
  NEW_LOCATION
  SUSPICIOUS_ACTIVITY
  FAILED_LOGIN_BURST
  PASSWORD_CHANGED
  @@schema("public")
}

model PatientSession {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  deviceId     String?       @db.Uuid
  userAgent    String?
  ipAddress    String?
  location     String?
  status       SessionStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  revokedAt    DateTime?

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device PatientDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@index([lastSeenAt])
  @@map("tb_patient_sessions")
  @@schema("public")
}

model PatientDevice {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  userId          String   @db.Uuid
  fingerprint     String   @unique
  label           String
  userAgent       String?
  platform        String?
  trusted         Boolean  @default(false)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions PatientSession[]

  @@index([tenantId, userId])
  @@map("tb_patient_devices")
  @@schema("public")
}

model SecurityAlert {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  kind         AlertKind
  severity     AlertSeverity
  title        String
  description  String
  metadata     Json?
  acknowledged Boolean       @default(false)
  acknowledgedAt DateTime?
  createdAt    DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, acknowledged])
  @@index([createdAt])
  @@map("tb_security_alerts")
  @@schema("public")
}

model PatientDocument {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  filename         String
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  classification   String    @default("GENERAL")
  watermarkEnabled Boolean   @default(true)
  uploadedAt       DateTime  @default(now())
  deletedAt        DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, uploadedAt])
  @@map("patient_documents")
  @@schema("public")
}

model Representative {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @db.Uuid
  patientId                  String    @db.Uuid
  representativeMembershipId String    @db.Uuid
  authorityType              String
  scope                      String[]
  validFrom                  DateTime  @default(now())
  validUntil                 DateTime?
  verificationStatus         String    @default("PENDING")
  initiatedBy                String
  requestedByMembershipId    String    @db.Uuid
  approvedByMembershipId     String?   @db.Uuid
  approvedAt                 DateTime?
  rejectionReason            String?
  evidenceNote               String?
  revokedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, representativeMembershipId, verificationStatus])
  @@map("representatives")
  @@schema("public")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  patientId      String    @db.Uuid
  type           String    // e.g. 'access.granted', 'document.uploaded', 'representative.verified'
  title          String
  message        String
  resourceType   String?   // e.g. 'document', 'representative', 'audit_event'
  resourceId     String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, patientId, isRead])
  @@map("notifications")
  @@schema("public")
}