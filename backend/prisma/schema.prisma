generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

// Ignore the Supabase Auth schema's models so Prisma won't try to manage them
model User {
  id String @id @db.Uuid
  @@schema("auth")
  @@ignore
}

// ============================================================
// Enums
// ============================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  @@schema("public")
}

enum MembershipRole {
  PATIENT
  STAFF
  HOSPITAL_ADMIN
  PRIVACY_OFFICER
  SECURITY_INVESTIGATOR
  SUPER_ADMIN
  @@schema("public")
}

// ============================================================
// Core tenant models
// ============================================================

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships Membership[]
  patients    Patient[]
  departments Department[]

  @@map("tenants")
  @@schema("public")
}

model UserIdentity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("user_identities")
  @@schema("public")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
  @@schema("public")
}

model Membership {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @db.Uuid
  userId           String         @db.Uuid
  role             MembershipRole
  active           Boolean        @default(true)
  departmentId     String?        @db.Uuid
  employmentStatus String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([departmentId])
  @@map("memberships")
  @@schema("public")
}

// ============================================================
// Clinical / operational models
// ============================================================

model Patient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime @db.Date
  hospitalNumber String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("patients")
  @@schema("public")
}

// ============================================================
// Audit
// ============================================================

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  resourceType  String?
  resourceId    String?
  outcome       String
  reasonCode    String?
  correlationId String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
  @@schema("public")
}