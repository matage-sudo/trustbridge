generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE — Tenant isolation model (see docs/architecture/ADR-0002):
// Prisma connects to Supabase as the `postgres` owner role. That role has
// BYPASSRLS, so RLS does NOT filter Prisma queries. Tenant isolation is
// enforced in the application layer:
//   1. TenantMiddleware populates AsyncLocalStorage (src/middleware/tenantContext.ts)
//   2. Every repository/service query filters by tenantId from currentTenant()
//   3. tests/tenant-isolation.e2e.test.ts attempts every cross-tenant read
// RLS is still enabled (see docs/runbooks/supabase-setup.md) to protect any
// future PostgREST / Supabase-JS access path.

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  PATIENT
  STAFF
  HOSPITAL_ADMIN
  PRIVACY_OFFICER
  SECURITY_INVESTIGATOR
  SUPER_ADMIN
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships Membership[]
  patients    Patient[]

  @@map("tenants")
}

model UserIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("user_identities")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  resourceType  String?
  resourceId    String?
  outcome       String
  reasonCode    String?
  correlationId String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model Patient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime @db.Date
  hospitalNumber String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("patients")
}