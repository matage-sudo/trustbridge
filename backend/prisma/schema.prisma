generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model User {
  id String @id @db.Uuid
  @@schema("auth")
  @@ignore
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  @@schema("public")
}

enum MembershipRole {
  PATIENT
  STAFF
  HOSPITAL_ADMIN
  PRIVACY_OFFICER
  SECURITY_INVESTIGATOR
  SUPER_ADMIN
  @@schema("public")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  @@schema("public")
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("public")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  @@schema("public")
}

enum AccessPurpose {
  TREATMENT
  DIAGNOSIS
  LAB_REVIEW
  PHARMACY_DISPENSE
  BILLING
  RESEARCH
  TEACHING
  AUDIT_REVIEW
  @@schema("public")
}

enum PatientSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("public")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships        Membership[]
  patients           Patient[]
  departments        Department[]
  appointments       Appointment[]
  consents           Consent[]
  accessRequests     AccessRequest[]
  accessGrants       AccessGrant[]
  documents          PatientDocument[]
  representatives    Representative[]
  emergencyAccess    EmergencyAccess[]
  notifications      Notification[]
  devices            PatientDevice[]
  sessions           PatientSession[]
  securityAlerts     SecurityAlert[]
  rightRequests      DataSubjectRequest[]
  staffAnnouncements StaffAnnouncement[]
  auditEvents        AuditEvent[]

  @@map("tenants")
  @@schema("public")
}

model UserIdentity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   Membership[]
  passkeys      PasskeyCredential[]
  recoveryCodes RecoveryCode[]

  @@map("user_identities")
  @@schema("public")
}

model PasskeyCredential {
  id           String   @id @default(uuid())
  userId       String   @db.Uuid
  user         UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique 
  publicKey    String   
  counter      Int      @default(0)
  deviceType   String   
  backedUp     Boolean
  transports   String?  
  createdAt    DateTime @default(now())

  @@map("passkey_credentials")
  @@schema("public")
}

model RecoveryCode {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("recovery_codes")
  @@schema("public")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
  @@schema("public")
}

model Membership {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @db.Uuid
  userId           String         @db.Uuid
  role             MembershipRole
  active           Boolean        @default(true)
  departmentId     String?        @db.Uuid
  patientId        String?        @db.Uuid 
  employmentStatus String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  patient    Patient?     @relation("PatientPrimary", fields: [patientId], references: [id], onDelete: SetNull)

  appointments              Appointment[]
  accessRequestsAsRequester AccessRequest[] @relation("AccessRequestsAsRequester")
  accessGrantsAsGrantee     AccessGrant[]   @relation("AccessGrantsAsGrantee")
  dataSubjectRequests       DataSubjectRequest[] @relation("DSRRequester")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([patientId])
  @@map("memberships")
  @@schema("public")
}

model Patient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime @db.Date
  hospitalNumber String   @unique
  nationalId             String?
  email                  String?
  phone                  String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  lastProfileUpdateAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  consents          Consent[]
  accessRequests    AccessRequest[]
  accessGrants      AccessGrant[]
  memberships       Membership[]        @relation("PatientPrimary")
  documents         PatientDocument[]
  representatives   Representative[]
  emergencyAccess   EmergencyAccess[]
  notifications     Notification[]
  devices           PatientDevice[]
  sessions          PatientSession[]
  securityAlerts    SecurityAlert[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([tenantId])
  @@map("patients")
  @@schema("public")
}

model Appointment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @db.Uuid
  patientId    String            @db.Uuid
  staffId      String            @db.Uuid
  scheduledAt  DateTime
  durationMins Int               @default(30)
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staff   Membership @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@index([patientId])
  @@index([staffId])
  @@map("tb_appointments")
  @@schema("public")
}

model Consent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @db.Uuid
  patientId        String        @db.Uuid
  purpose          String
  noticeVersion    String
  language         String        @default("en")
  grantedAt        DateTime      @default(now())
  effectiveFrom    DateTime      @default(now())
  expiresAt        DateTime?
  status           ConsentStatus @default(ACTIVE)
  revokedAt        DateTime?
  revocationReason String?
  capturedBy       String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([patientId])
  @@map("tb_consents")
  @@schema("public")
}

model AccessRequest {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @db.Uuid
  requesterId            String              @db.Uuid
  patientId              String              @db.Uuid
  purpose                AccessPurpose
  reason                 String
  requestedDurationHours Int                 @default(4)
  status                 AccessRequestStatus @default(PENDING)
  decisionReason         String?
  decidedBy              String?             @db.Uuid
  decidedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester Membership @relation("AccessRequestsAsRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grant     AccessGrant?

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([patientId])
  @@map("tb_access_requests")
  @@schema("public")
}

model AccessGrant {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @db.Uuid
  requestId        String        @unique @db.Uuid
  granteeId        String        @db.Uuid
  patientId        String        @db.Uuid
  purpose          AccessPurpose
  grantedAt        DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantee Membership    @relation("AccessGrantsAsGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([granteeId])
  @@index([patientId])
  @@index([expiresAt])
  @@map("tb_access_grants")
  @@schema("public")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action        String
  resourceType  String?
  resourceId    String?
  outcome       String
  reasonCode    String?
  correlationId String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
  @@schema("public")
}

model PatientDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  storageKey       String
  filename         String
  mimeType         String
  sizeBytes        Int
  classification   String?
  watermarkEnabled Boolean   @default(true)
  uploadedAt       DateTime  @default(now())
  deletedAt        DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_documents")
  @@schema("public")
}

model Representative {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String    @db.Uuid
  patientId                  String    @db.Uuid
  representativeMembershipId String    @db.Uuid
  authorityType              String
  scope                      String[]
  validUntil                 DateTime?
  verificationStatus         String    @default("PENDING")
  initiatedBy                String
  requestedByMembershipId    String    @db.Uuid
  approvedByMembershipId     String?   @db.Uuid
  approvedAt                 DateTime?
  evidenceNote               String?
  rejectionReason            String?
  revokedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([representativeMembershipId])
  @@map("representatives")
  @@schema("public")
}

model EmergencyAccess {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  patientId     String    @db.Uuid
  staffMemberId String    @db.Uuid
  justification String
  purpose       String
  scope         String[]
  validUntil    DateTime
  revokedAt     DateTime?
  revokedBy     String?   @db.Uuid
  reviewedAt    DateTime?
  reviewedBy    String?   @db.Uuid
  reviewOutcome String?
  createdAt     DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([staffMemberId])
  @@map("emergency_access")
  @@schema("public")
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  patientId    String    @db.Uuid
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, isRead])
  @@map("notifications")
  @@schema("public")
}

model DataSubjectRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  referenceNumber String    @unique
  requesterId     String    @db.Uuid
  patientId       String?   @db.Uuid
  type            String
  description     String
  status          String    @default("PENDING")
  adminResponse   String?
  respondedBy     String?   @db.Uuid
  respondedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester Membership @relation("DSRRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  patient   Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([patientId])
  @@map("tb_data_subject_requests")
  @@schema("public")
}

model PatientDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  fingerprint String   @unique
  label       String
  userAgent   String?
  platform    String?
  trusted     Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions PatientSession[]

  @@index([tenantId, userId])
  @@map("tb_patient_devices")
  @@schema("public")
}

model PatientSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  deviceId   String   @db.Uuid
  userAgent  String?
  ipAddress  String?
  location   String?
  status     PatientSessionStatus   @default(ACTIVE)
  revokedAt  DateTime?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  PatientDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@map("tb_patient_sessions")
  @@schema("public")
}

model SecurityAlert {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  kind         String
  severity     String
  title        String
  description  String
  metadata     Json?
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("tb_security_alerts")
  @@schema("public")
}

model StaffAnnouncement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("staff_announcements")
  @@schema("public")
}

model LabResult {
  id             String    @id @default(uuid())
  tenantId       String
  patientId      String
  testName       String
  resultValue    String?
  referenceRange String?
  status         String    @default("PENDING")
  notes          String?
  orderedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("lab_results")
  @@schema("public")
}

model Prescription {
  id           String    @id @default(uuid())
  tenantId     String
  patientId    String
  medication   String
  dosage       String
  frequency    String
  duration     String?
  instructions String?
  status       String    @default("ACTIVE")
  prescribedBy String?
  prescribedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, patientId])
  @@map("prescriptions")
  @@schema("public")
}

model Diagnosis {
  id          String    @id @default(uuid())
  tenantId    String
  patientId   String
  condition   String
  code        String?
  severity    String?
  status      String    @default("ACTIVE")
  diagnosedBy String?
  notes       String?
  diagnosedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, patientId])
  @@map("diagnoses")
  @@schema("public")
}

model Vitals {
  id            String   @id @default(uuid())
  tenantId      String
  patientId     String
  bloodPressure String?
  heartRate     Int?
  temperature   Float?
  weight        Float?
  height        Float?
  oxygenSat     Int?
  recordedBy    String?
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("vitals")
  @@schema("public")
}

model SupportTicket {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  patientId  String?
  subject    String
  category   String    @default("GENERAL")
  message    String
  status     String    @default("OPEN")
  priority   String    @default("NORMAL")
  adminReply String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@map("support_tickets")
  @@schema("public")
}